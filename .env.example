# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit)
# ---------------------------------------------------------------

# Channel access token (long-lived) ของ Messaging API channel
# หาได้จาก: LINE Developers Console > เลือก Provider > เลือก Channel (Messaging API)
#           > แท็บ "Messaging API" > หัวข้อ "Channel access token" > กด Issue
LINE_CHANNEL_ACCESS_TOKEN=

# ปลายทางที่จะให้ข้อความเด้งเข้า ใส่ได้ทั้ง userId / groupId / roomId
#
# วิธีหา userId ของตัวเอง (ง่ายที่สุด):
#   LINE Developers Console > แท็บ "Basic settings" > เลื่อนลงล่างสุด > "Your user ID"
#   (ต้องเพิ่ม LINE OA นี้เป็นเพื่อนก่อน จึงจะ push หาตัวเองได้)
#
# ถ้าต้องการให้เข้ากลุ่มทีมงาน: เชิญ OA เข้ากลุ่ม แล้วอ่าน groupId
# จาก webhook event ที่ LINE ส่งมา
LINE_TO=
